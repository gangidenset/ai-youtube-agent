# ---------------------------------------------------------------
# AI YouTube Agent - 環境変数サンプル
# このファイルをコピーして .env を作成してください（.env はコミット禁止）
# Secret は Backend（api / worker）でのみ使用します。
# NEXT_PUBLIC_ で始まる変数に Secret を入れないでください。
# ---------------------------------------------------------------

NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DEFAULT_LANGUAGE=ja
DEFAULT_REGION=JP
API_PORT=4000
# リバースプロキシの段数（本番の Render + web の rewrite 経由なら環境に合わせて設定）。ローカルは 0
TRUST_PROXY_HOPS=0

# --- Database / Queue ---
DATABASE_URL=postgresql://aya:aya@localhost:5432/aya
REDIS_URL=redis://localhost:6379

# --- Auth / Crypto（pnpm env:init で自動生成。手動の場合: SESSION_SECRET は 32 文字以上、
#     TOKEN_ENCRYPTION_KEY は `openssl rand -base64 32` の出力） ---
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# --- 外部サービスの API キー（未設定なら mock で動く。本番では必須） ---

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-opus-5-5

# --- YouTube ---
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/oauth/youtube/callback

# --- Storage (S3 互換: 開発は MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=aya-dev
# 以下 2 行はローカルの MinIO（infra/docker/docker-compose.yml）用の開発専用値
S3_ACCESS_KEY_ID=aya-dev
S3_SECRET_ACCESS_KEY=aya-dev-password

# --- Video Providers (Phase 2) ---
# 本番: kling（ADR-002）
VIDEO_PROVIDER_ORDER=mock
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# --- TTS Providers (Phase 2) ---
# 本番: google（ADR-003）
TTS_PROVIDER_ORDER=mock
GOOGLE_TTS_CREDENTIALS=

# --- Notification ---
MAIL_API_KEY=
MAIL_FROM=

# --- 開発用シード（pnpm db:seed）。初回は SEED_OWNER_PASSWORD（12 文字以上）を自分で設定する ---
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=

# --- Budget defaults (USD) ---
DEFAULT_DAILY_BUDGET_USD=30
DEFAULT_MONTHLY_BUDGET_USD=600
DEFAULT_PER_VIDEO_BUDGET_USD=10
