# ---------------------------------------------------------------
# AI YouTube Agent - 環境変数サンプル
# このファイルをコピーして .env を作成してください（.env はコミット禁止）
# Secret は Backend（api / worker）でのみ使用します。
# NEXT_PUBLIC_ で始まる変数に Secret を入れないでください。
# ---------------------------------------------------------------

NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DEFAULT_LANGUAGE=ja
DEFAULT_REGION=JP
API_PORT=4000

# --- Database / Queue ---
DATABASE_URL=postgresql://aya:aya@localhost:5432/aya
REDIS_URL=redis://localhost:6379

# --- Auth / Crypto（32 byte 以上のランダム値を生成して設定） ---
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-opus-5-5

# --- YouTube ---
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/oauth/youtube/callback

# --- Storage (S3 互換: 開発は MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=aya-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Video Providers (Phase 2) ---
# 本番: kling（ADR-002）
VIDEO_PROVIDER_ORDER=mock
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# --- TTS Providers (Phase 2) ---
# 本番: google（ADR-003）
TTS_PROVIDER_ORDER=mock
GOOGLE_TTS_CREDENTIALS=

# --- Notification ---
MAIL_API_KEY=
MAIL_FROM=

# --- Budget defaults (USD) ---
DEFAULT_DAILY_BUDGET_USD=30
DEFAULT_MONTHLY_BUDGET_USD=600
DEFAULT_PER_VIDEO_BUDGET_USD=10
